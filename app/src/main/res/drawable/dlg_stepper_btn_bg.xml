<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#FFE0C4" />
            <stroke android:width="1.5dp" android:color="#E58332" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFF4E6" />
            <stroke android:width="1.5dp" android:color="#F0C8A0" />
        </shape>
    </item>
</selector>
