<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
>

    <!-- Card content — vertical so the tags row can span full width -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp"
        android:background="@drawable/bg_card">

        <!-- Main row: checkbox · image+progress · text · right-primary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- Selection Checkbox -->
            <CheckBox
                android:id="@+id/cb_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:buttonTint="@color/accent_orange" />

            <LinearLayout
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <ImageView
                    android:id="@+id/img_item"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/profile_placeholder"
                    android:scaleType="centerCrop" />
            </LinearLayout>

            <!-- Right Content (name / sub-info / date) — no tags here any more -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Fresh milk"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#514438"
                        android:singleLine="true"
                        android:ellipsize="end"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tv_expiry_state"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_default="wrap" />

                    <TextView
                        android:id="@+id/tv_expiry_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Near expiry"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_orange"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_tag"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_name"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tv_sub_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Food · Remaining 10"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:layout_marginTop="6dp"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tv_target_date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Expiry date 2026.05.15"
                        android:textSize="12sp"
                        android:textColor="#888888"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tv_right_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="end"
                android:minWidth="56dp"
                android:text="3 days"
                android:textColor="#514438"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottom_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <FrameLayout
                android:id="@+id/progress_container"
                android:layout_width="64dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:background="@android:color/transparent">

                <View
                    android:id="@+id/view_progress_track"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_gravity="bottom"
                    android:background="#E6D8C9" />

                <View
                    android:id="@+id/view_progress"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_gravity="bottom"
                    android:background="#6ED26B" />

                <TextView
                    android:id="@+id/tv_progress_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:text="47%"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#514438"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:visibility="gone" />
            </FrameLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/tags_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_tag_opened"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Opened"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#E685ED"
                    android:background="@drawable/bg_tag"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:singleLine="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_tag_storage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chilled"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#0B9ED4"
                    android:background="@drawable/bg_tag"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:singleLine="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_tag_from_user"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#C25E00"
                    android:letterSpacing="0.02"
                    android:background="@drawable/bg_tag_from_other"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_tag_shared"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shared"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#26A69A"
                    android:background="@drawable/bg_tag"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:singleLine="true"
                    android:visibility="gone" />

                <androidx.constraintlayout.helper.widget.Flow
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="tv_tag_opened,tv_tag_storage,tv_tag_from_user,tv_tag_shared"
                    app:flow_horizontalGap="8dp"
                    app:flow_verticalGap="6dp"
                    app:flow_wrapMode="aligned"
                    app:flow_horizontalStyle="packed"
                    app:flow_horizontalBias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Left accent strip — visible only for items shared by other users -->
    <View
        android:id="@+id/view_from_accent"
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:visibility="gone" />

</FrameLayout>
