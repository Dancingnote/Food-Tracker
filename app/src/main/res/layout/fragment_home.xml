<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffe9d0"
    android:clipChildren="false">

    <!-- Select Top Bar -->
    <LinearLayout
        android:id="@+id/select_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#fff7ef"
        android:elevation="4dp"
        android:translationZ="10dp"
        android:visibility="gone"
        >

        <TextView
            android:id="@+id/tv_select_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select All"
            android:textColor="#514438"
            android:textStyle="bold"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_exit_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exit"
            android:textColor="#514438"
            android:textStyle="bold"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Main Content -->
    <LinearLayout
        android:id="@+id/home_main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:background="#ffe9d0">

        <!-- Greeting Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/greeting_bar"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_greeting_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hi, Serena!"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#514438" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_user_image"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/profile_placeholder"
                android:background="@drawable/circle_bg"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:outlineProvider="background" />
        </LinearLayout>

        <!-- Search Bar -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/search_bar"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="20dp"
            android:elevation="8dp"
            app:cardBackgroundColor="#F5F5F5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:hint="Enter Product"
                    android:textColorHint="#888888"
                    android:textColor="#111111"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_search"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#514438"
                    android:paddingStart="10dp"
                    android:paddingEnd="4dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Toolbar Row -->
        <LinearLayout
            android:id="@+id/normal_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_sort"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_sort"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/iv_filter"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_filter"
                android:layout_marginEnd="15dp"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/iv_archive_toggle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_archive"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/iv_select"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_select"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_archive_section_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Unarchived"
            android:textColor="@color/text_second"
            android:textSize="13sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_food_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="70dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Select Bottom Bar -->
    <LinearLayout
        android:id="@+id/select_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:background="#fff7ef"
        android:elevation="4dp"
        android:translationZ="10dp"
        android:visibility="gone"
        >

        <!-- Delete Button -->
        <LinearLayout
            android:id="@+id/layout_delete"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_delete" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="Delete"
                android:textColor="#FC2200"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Archive Button -->
        <LinearLayout
            android:id="@+id/layout_archive"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iv_archive_action"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_archive" />

            <TextView
                android:id="@+id/tv_archive_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Archive"
                android:textColor="#514438"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>

</FrameLayout>
