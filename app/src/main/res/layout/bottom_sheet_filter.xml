<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="0dp"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:cardUseCompatPadding="false"
        app:cardPreventCornerOverlap="false"
        app:cardBackgroundColor="#fff7ef">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- TOP BAR -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filter"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#514438"/>

                <ImageView
                    android:id="@+id/btn_close"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_close"
                    android:padding="4dp"/>
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="12dp"/>

            <!-- TAGS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tags"
                android:textStyle="bold"
                android:textColor="#514438"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tag_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/tag_fruit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fruit"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/tag_vegetable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vegetable"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/tag_meat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Meat"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/tag_seafood"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Seafood"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/tag_dairy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dairy"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/tag_bakery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bakery"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/tag_snack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Snack"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/tag_frozen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Frozen"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/tag_drink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Drink"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/tag_healthy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Healthy"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/tag_sweet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sweet"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/tag_spicy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Spicy"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- NEAR EXPIRY -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Near Expiry"
                android:textStyle="bold"
                android:textColor="#514438"
                android:layout_marginTop="14dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/near_exp_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unlimited"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/near_exp_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 days left"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/near_exp_10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10 days left"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/near_exp_15"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15 days left"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/near_exp_30"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30 days left"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- EXPIRED -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expired"
                android:textStyle="bold"
                android:textColor="#514438"
                android:layout_marginTop="14dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/exp_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unlimited"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/exp_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Within 5 days"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/exp_10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Within 10 days"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/exp_15"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Within 15 days"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/exp_30"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Within 30 days"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- STORAGE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Storage"
                android:textStyle="bold"
                android:textColor="#514438"
                android:layout_marginTop="14dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/storage_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/storage_room"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Room temp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/storage_chilled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chilled"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/storage_frozen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Frozen"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- FOOD STATUS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Food Status"
                android:textStyle="bold"
                android:textColor="#514438"
                android:layout_marginTop="14dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/status_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/status_fresh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fresh"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/status_near_expiry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Near expiry"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/status_expired"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expired"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- OPENED -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Opened"
                android:textStyle="bold"
                android:textColor="#514438"
                android:layout_marginTop="14dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/opened_filter_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/opened_filter_yes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Opened"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/opened_filter_no"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unopened"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- SHARED -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shared"
                android:textStyle="bold"
                android:textColor="#514438"
                android:layout_marginTop="14dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/shared_filter_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/shared_filter_yes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shared"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/shared_filter_no"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Not shared"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/shared_filter_from_other"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="From others"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tag_bg"
                        android:textColor="#514438"
                        android:layout_marginEnd="10dp"/>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- BUTTONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:layout_marginTop="18dp">

                <TextView
                    android:id="@+id/btn_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reset"
                    android:textColor="#514438"
                    android:padding="10dp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/btn_confirm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confirm"
                    android:textColor="#ffffff"
                    android:textStyle="bold"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="10dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/save_btn_bg"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
