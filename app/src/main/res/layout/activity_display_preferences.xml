<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/text_main"
            android:textSize="28sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Display Preferences"
            android:textColor="@color/text_main"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sample"
                android:textColor="@color/text_second"
                android:textSize="13sp"
                android:layout_marginBottom="10dp" />

            <include
                android:id="@+id/sample_item"
                layout="@layout/item_product" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Primary Display"
                android:textColor="@color/text_second"
                android:textSize="13sp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#ffe9d0"
                android:orientation="vertical"
                android:padding="12dp">

                <RadioGroup
                    android:id="@+id/rgPriority"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbPriorityRemainingTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Remaining Time"
                        android:textColor="@color/text_main" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E6D8C9"
                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="18dp" />

                    <RadioButton
                        android:id="@+id/rbPriorityRemainingStock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Remaining Stock"
                        android:textColor="@color/text_main" />

                </RadioGroup>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Remaining Time Style"
                android:textColor="@color/text_second"
                android:textSize="13sp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#ffe9d0"
                android:orientation="vertical"
                android:padding="12dp">

                <RadioGroup
                    android:id="@+id/rgRemainingStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbStyleDynamic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dynamic (d/m/y)"
                        android:textColor="@color/text_main" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E6D8C9"
                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="18dp" />

                    <RadioButton
                        android:id="@+id/rbStyleDaysOnly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Days Only"
                        android:textColor="@color/text_main" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E6D8C9"
                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="18dp" />

                    <RadioButton
                        android:id="@+id/rbStyleTargetDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Expiry / Near-expiry Date"
                        android:textColor="@color/text_main" />

                </RadioGroup>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Remaining Time Type"
                android:textColor="@color/text_second"
                android:textSize="13sp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#ffe9d0"
                android:orientation="vertical"
                android:padding="12dp">

                <RadioGroup
                    android:id="@+id/rgRemainingType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbTypeExpiry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="By Expiry Date"
                        android:textColor="@color/text_main" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E6D8C9"
                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="18dp" />

                    <RadioButton
                        android:id="@+id/rbTypeNearExpiry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="By Near-expiry Date"
                        android:textColor="@color/text_main" />

                </RadioGroup>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Date Format"
                android:textColor="@color/text_second"
                android:textSize="13sp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#ffe9d0"
                android:orientation="vertical"
                android:padding="12dp">

                <RadioGroup
                    android:id="@+id/rgDateFormat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbDateFmtDot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="10.05.2026"
                        android:textColor="@color/text_main" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E6D8C9"
                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="18dp" />

                    <RadioButton
                        android:id="@+id/rbDateFmtSlash"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="10/05/2026"
                        android:textColor="@color/text_main" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E6D8C9"
                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="18dp" />

                    <RadioButton
                        android:id="@+id/rbDateFmtDash"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="10-05-2026"
                        android:textColor="@color/text_main" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E6D8C9"
                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="18dp" />

                    <RadioButton
                        android:id="@+id/rbDateFmtCn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="10 May 2026"
                        android:textColor="@color/text_main" />

                </RadioGroup>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Include Production Day in Shelf Life"
                android:textColor="@color/text_second"
                android:textSize="13sp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#ffe9d0"
                android:orientation="vertical"
                android:padding="12dp">

                <RadioGroup
                    android:id="@+id/rgIncludeProdDay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbIncludeProdYes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Include"
                        android:textColor="@color/text_main" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E6D8C9"
                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="18dp" />

                    <RadioButton
                        android:id="@+id/rbIncludeProdNo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Exclude"
                        android:textColor="@color/text_main" />

                </RadioGroup>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
