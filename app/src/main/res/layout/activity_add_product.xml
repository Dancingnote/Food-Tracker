<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffe9d0">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#514438"
            android:textSize="16sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_page_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Product"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#514438" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFF8F1"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:background="@drawable/save_btn_bg"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:fillViewport="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- Product Image -->
        <ImageView
            android:id="@+id/iv_product"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:layout_marginTop="28dp"
            android:src="@drawable/profile_placeholder"
            android:background="@drawable/circle_bg"
            android:scaleType="centerCrop"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Scan package label → OCR autofill -->
        <LinearLayout
            android:id="@+id/btn_scan_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:background="@drawable/tag_bg"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Scan package label to autofill">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_scan"
                app:tint="#514438"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Scan label to autofill"
                android:textColor="#514438"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Product Name"
            android:textColor="#8A7B6E"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Required"
            android:padding="14dp"
            android:background="@drawable/search_bg"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Quantity"
            android:textColor="#8A7B6E"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_quantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Required"
            android:inputType="number"
            android:padding="14dp"
            android:background="@drawable/search_bg"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Price per unit"
            android:textColor="#8A7B6E"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Optional"
            android:inputType="numberDecimal"
            android:padding="14dp"
            android:background="@drawable/search_bg"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Added Date"
            android:textColor="#8A7B6E"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_created_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:padding="14dp"
            android:background="@drawable/search_bg"
            android:focusable="false"
            android:clickable="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Production Date"
            android:textColor="#8A7B6E"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_production_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Optional"
            android:padding="14dp"
            android:background="@drawable/search_bg"
            android:focusable="false"
            android:clickable="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Expire Date"
            android:textColor="#8A7B6E"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_expire_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Required"
            android:padding="14dp"
            android:background="@drawable/search_bg"
            android:focusable="false"
            android:clickable="true"/>

        <!-- Tags Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category(Required)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#514438"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- Tags — FlexboxLayout wraps automatically on any screen width -->
        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:flexWrap="wrap"
            app:flexDirection="row"
            app:alignItems="flex_start"
            app:justifyContent="flex_start">

            <TextView
                android:id="@+id/tag_fruit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fruit"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/tag_bg"
                android:textColor="#514438"
                android:layout_margin="4dp" />

            <TextView
                android:id="@+id/tag_vegetable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vegetable"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/tag_bg"
                android:textColor="#514438"
                android:layout_margin="4dp" />

            <TextView
                android:id="@+id/tag_meat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meat"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/tag_bg"
                android:textColor="#514438"
                android:layout_margin="4dp" />

            <TextView
                android:id="@+id/tag_seafood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seafood"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/tag_bg"
                android:textColor="#514438"
                android:layout_margin="4dp" />

            <TextView
                android:id="@+id/tag_dairy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dairy"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/tag_bg"
                android:textColor="#514438"
                android:layout_margin="4dp" />

            <TextView
                android:id="@+id/tag_bakery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bakery"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/tag_bg"
                android:textColor="#514438"
                android:layout_margin="4dp" />

            <TextView
                android:id="@+id/tag_snack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Snack"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/tag_bg"
                android:textColor="#514438"
                android:layout_margin="4dp" />

            <TextView
                android:id="@+id/tag_frozen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Frozen"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/tag_bg"
                android:textColor="#514438"
                android:layout_margin="4dp" />

            <TextView
                android:id="@+id/tag_drink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drink"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/tag_bg"
                android:textColor="#514438"
                android:layout_margin="4dp" />

            <TextView
                android:id="@+id/tag_healthy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Healthy"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/tag_bg"
                android:textColor="#514438"
                android:layout_margin="4dp" />

            <TextView
                android:id="@+id/tag_sweet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sweet"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/tag_bg"
                android:textColor="#514438"
                android:layout_margin="4dp" />

            <TextView
                android:id="@+id/tag_spicy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spicy"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/tag_bg"
                android:textColor="#514438"
                android:layout_margin="4dp" />

        </com.google.android.flexbox.FlexboxLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Storage"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#514438"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/storage_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room temp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/tag_bg"
                android:textColor="#514438"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/storage_fridge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chilled"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/tag_bg"
                android:textColor="#514438"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/storage_freezer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Frozen"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/tag_bg"
                android:textColor="#514438"
                android:layout_marginEnd="10dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Opened"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#514438"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/opened_yes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yes"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/tag_bg"
                android:textColor="#514438"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/opened_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/tag_bg"
                android:textColor="#514438"
                android:layout_marginEnd="10dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Share?"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#514438"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/shared_yes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yes"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/tag_bg"
                android:textColor="#514438"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/shared_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/tag_bg"
                android:textColor="#514438"
                android:layout_marginEnd="10dp"/>
        </LinearLayout>

    </LinearLayout>

</ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
